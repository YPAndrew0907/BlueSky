# Local-only environment variables for Bluesky data collection.
#
# Usage:
#   cp .env.local.example .env.local
#   $EDITOR .env.local
#   set -a; source .env.local; set +a
#
# Never commit `.env.local`.

# Handle/email/DID
BLUESKY_IDENTIFIER=

# App password (recommended: store in macOS Keychain instead of here)
BLUESKY_APP_PASSWORD=

# AppView host (public reads)
BLUESKY_APPVIEW=https://bsky.social

# Optional: generated values (see `scripts/save_session_env.sh`)
BLUESKY_DID=
BLUESKY_HANDLE=
BLUESKY_PDS=
BLUESKY_ACCESS_JWT=
BLUESKY_REFRESH_JWT=

